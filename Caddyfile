# Reverse proxy to Sylver_Portfolio over Railway private networking.
# Railway terminates TLS before it gets to Caddy.

{
	auto_https off
	admin off
}

:8080 {

	@railway_health {
		path /health
		host healthcheck.railway.app
	}

	handle @railway_health {
		respond "OK" 200
	}

	encode zstd gzip

	handle {
		reverse_proxy sylverportfolio.railway.internal:8080
	}
}
